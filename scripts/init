#!/usr/bin/env bash
# ws init — once per machine: clone the repos, then initialize bernini.
#
# Clones bernini and bernini-test-project into the workspace root (skipping any
# that already exist), then runs `just init` in bernini/ — which generates the
# machine config.json, installs the git hooks, and configures the LFS transfer
# agent (see bernini/docs/lfs.md).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BERNINI_URL="git@github.com:alexjiang200407/bernini.git"
TEST_PROJECT_URL="git@github.com:alexjiang200407/bernini-test-project.git"

if [ -d "$ROOT/bernini/.git" ]; then
    echo "bernini/ already cloned — skipping"
else
    git clone "$BERNINI_URL" "$ROOT/bernini"
fi

if [ -d "$ROOT/bernini-test-project/.git" ]; then
    echo "bernini-test-project/ already cloned — skipping"
else
    git clone "$TEST_PROJECT_URL" "$ROOT/bernini-test-project"
fi

# tmux hosts the feature agent sessions (ws feature). Install it the way
# bernini's init.py treats its tools: obtainable without a decision, so obtain
# it — through the platform package manager. python3 is assumed on PATH, same
# as in bernini.
if ! command -v tmux >/dev/null 2>&1; then
    case "$(uname -s)" in
        Darwin)
            if command -v brew >/dev/null 2>&1; then
                brew install tmux
            else
                echo "warning: tmux missing and no Homebrew found — install tmux by hand" >&2
            fi ;;
        Linux)
            # apt first as the native choice; Homebrew also runs on Linux, so
            # a machine that has it can install without sudo.
            if command -v apt-get >/dev/null 2>&1; then
                sudo apt-get install -y tmux
            elif command -v brew >/dev/null 2>&1; then
                brew install tmux
            else
                echo "warning: tmux missing — install it with your package manager" >&2
            fi ;;
    esac
fi

cd "$ROOT/bernini"
if [ -f scripts/config.json ]; then
    echo "bernini already initialized (scripts/config.json exists) — skipping just init"
elif command -v just >/dev/null 2>&1; then
    just init
else
    python3 scripts/init.py
fi

# Point every checkout's editor at the test project clone. Idempotent and not
# only for a fresh machine: re-running ws init is how checkouts made before
# this existed get their apps/editor/config.json.
"$ROOT/scripts/_editor-config" || true

# Put `ws` on PATH so the commands work bare (`ws feature vat`) from anywhere.
if ! command -v ws >/dev/null 2>&1 && [ -d "$HOME/.local/bin" ]; then
    ln -s "$ROOT/ws" "$HOME/.local/bin/ws"
    echo "symlinked ws into ~/.local/bin"
fi
