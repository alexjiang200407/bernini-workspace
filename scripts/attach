#!/usr/bin/env bash
# ws attach [<name>] — watch the agents: attach to the tmux session (or one feature's window).
#
# Detach again with Ctrl-b d. With no <name> the view has every feature's
# window: Ctrl-b n/p cycles them, Ctrl-b w lists them.
#
# Each terminal gets its own *view* session rather than attaching to `ws`
# itself. Two clients of one session share that session's current window, so a
# second terminal jumping to another feature drags the first one along with it.
# The view is scaffolding: it is killed when its terminal is done with it, and
# the windows outlive it because they belong to `ws`.
#
# The two views differ in what they hold, and that is what decides where the
# terminal lands when an agent's window goes away:
#
#   ws attach          a session *grouped* with `ws`: the same window list (new
#                      ws feature windows appear, ws done windows vanish) with
#                      its own selection. You asked to watch all the agents, so
#                      when one window closes tmux moves you to another.
#   ws attach <name>   a session holding exactly that one window, linked in
#                      from `ws`. Grouping here is worse than useless: exiting
#                      the agent (Ctrl-d in claude) closes the window, and tmux
#                      slides the terminal onto whichever window is next — you
#                      are suddenly typing into a different feature's live
#                      agent with no sign it changed. With only that window in
#                      the session, closing it empties the session, tmux
#                      destroys it and the terminal drops back to your shell.
#
# The window is a link, not a copy: it is the same window `ws` holds, so the
# view can be killed (detach, teardown) without touching the agent.
set -euo pipefail

NAME="${1-}"

if ! tmux has-session -t ws 2>/dev/null; then
    echo "no agent session running (ws feature <name> starts one)" >&2
    exit 1
fi

if [ -n "$NAME" ] && ! tmux list-windows -t ws -F '#W' | grep -qx -- "$NAME"; then
    echo "no agent window ws:$NAME — ws list shows the live features" >&2
    exit 1
fi

# Views whose terminal died without detaching (a closed terminal window, a
# dropped ssh) are left behind unattached. Reap them here — but only once they
# are old enough that they cannot be another ws attach in the split second
# between creating its view and attaching to it.
NOW="$(date +%s)"
while read -r VS ATTACHED CREATED; do
    case "$VS" in ws-view-*) ;; *) continue ;; esac
    if [ "$ATTACHED" = 0 ] && [ $((NOW - CREATED)) -gt 60 ]; then
        tmux kill-session -t "=$VS" 2>/dev/null || true
    fi
done < <(tmux list-sessions -F '#{session_name} #{session_attached} #{session_created}' 2>/dev/null || true)

# One view per terminal, not per feature: the same agent can be watched from
# two terminals at once, each with its own selection.
VIEW="ws-view-$$"
N=0
while tmux has-session -t "=$VIEW" 2>/dev/null; do
    N=$((N + 1))
    VIEW="ws-view-$$-$N"
done
if [ -n "$NAME" ]; then
    # tmux has no "session from an existing window", so the session is born
    # with a throwaway window, the agent's is linked in beside it, and the
    # throwaway goes — leaving the one window that is the whole point.
    PLACEHOLDER="$(tmux new-session -d -P -F '#{window_id}' -s "$VIEW")"
    if ! tmux link-window -s "ws:$NAME" -t "$VIEW:"; then
        tmux kill-session -t "=$VIEW" 2>/dev/null || true
        echo "could not put ws:$NAME in a view of its own" >&2
        exit 1
    fi
    tmux kill-window -t "$PLACEHOLDER"
else
    tmux new-session -d -t ws -s "$VIEW"
fi

if [ -n "${TMUX-}" ]; then
    # Already inside tmux: hand this client over to the view. destroy-unattached
    # goes on only *after* the client is there — tmux reaps an unattached
    # session the moment the option is set, which would kill the view out from
    # under the switch.
    #
    # detach-on-destroy stays at its default `on`, so an agent that exits drops
    # this terminal out of tmux altogether rather than back into the session it
    # came from. `off` reads like the kinder answer and is the bug again: it
    # sends the client to the most recently active remaining session, which on
    # a workspace with other terminals watching agents is another agent's view.
    if tmux switch-client -t "$VIEW"; then
        tmux set-option -t "$VIEW" destroy-unattached on
    else
        tmux kill-session -t "=$VIEW" 2>/dev/null || true
        exit 1
    fi
else
    # attach blocks until this terminal detaches, so the view is torn down on
    # the way out — by the trap too, for a terminal that is closed rather than
    # detached.
    trap 'tmux kill-session -t "=$VIEW" 2>/dev/null || true' EXIT HUP INT TERM
    tmux attach -t "$VIEW"
fi
