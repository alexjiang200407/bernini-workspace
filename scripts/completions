#!/usr/bin/env bash
# ws completions [<zsh|bash>] [--install] — the shell completion script for ws.
#
# Prints it; `--install` puts it where the shell will find it (and says what it
# did). Without a shell it takes yours from $SHELL.
#
#   ws completions --install         # once per machine, then open a new shell
#   ws completions zsh > ~/.zfunc/_ws
#
# The shims are deliberately thin — they ask `ws __complete` what to offer and
# hand the answer to the shell. Everything that knows about ws lives there, so
# these two never need editing when a command or a flag is added.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WS="$ROOT/ws"
USAGE='usage: ws completions [<zsh|bash>] [--install]'
SHELL_NAME=""
INSTALL=""
while [ $# -gt 0 ]; do
    case "$1" in
        --install) INSTALL=1; shift ;;
        zsh | bash) SHELL_NAME="$1"; shift ;;
        *) echo "$USAGE" >&2; exit 1 ;;
    esac
done
# The shell being used is the one that wants completing.
if [ -z "$SHELL_NAME" ]; then
    SHELL_NAME="$(basename "${SHELL:-}")"
    case "$SHELL_NAME" in
        zsh | bash) ;;
        *) echo "ws completions: no shell given and \$SHELL is '${SHELL:-unset}' — $USAGE" >&2; exit 1 ;;
    esac
fi

zsh_shim() {
    cat <<'SHIM'
#compdef ws
# Generated by `ws completions zsh` — regenerate it, don't edit it.
_ws() {
    local -a lines
    lines=( ${(f)"$(@WS@ __complete $(( CURRENT - 1 )) "${words[@]}" 2>/dev/null)"} )
    lines=( ${lines:#} )
    # Nothing to offer means nothing to offer. Returning non-zero here would
    # send zsh to _default, and completing ws's arguments to the filenames in
    # the current directory is worse than saying "no matches".
    (( ${#lines} )) || return 0

    if [[ ${lines[1]} == ':delegate '* ]]; then
        # `ws cmd <name> -- <command>`: from here on the line is somebody else's
        # command, so hand it to the completion zsh would run at a bare prompt.
        local -a spec
        spec=( ${(s: :)lines[1]} )
        local start=${spec[2]} dir=${lines[1]#:delegate ${spec[2]} }
        # ...from inside the checkout, so its relative paths complete against
        # the directory the command will actually run in. Restored always,
        # including when _normal bails out.
        local here=$PWD
        [[ -d $dir ]] && builtin cd -q -- $dir
        {
            shift $start words
            (( CURRENT -= start ))
            _normal -p ws
        } always {
            builtin cd -q -- $here
        }
        return
    fi

    # value<TAB>description is the wire format; value:description is what
    # _describe wants (and what puts the descriptions in the menu).
    local -a cands
    local line
    for line in $lines; do
        cands+=( "${line//$'\t'/:}" )
    done
    _describe -t ws 'ws' cands
}

# Sourced through `eval` the function has to be registered; autoloaded from an
# fpath directory it is called instead, with the completion state already set.
if [[ ${funcstack[1]} == _ws ]]; then
    _ws "$@"
else
    compdef _ws ws
fi
SHIM
}

bash_shim() {
    cat <<'SHIM'
# Generated by `ws completions bash` — regenerate it, don't edit it.
_ws() {
    local cur="${COMP_WORDS[COMP_CWORD]}" out first
    out="$(@WS@ __complete "$COMP_CWORD" "${COMP_WORDS[@]}" 2>/dev/null)" || return
    [ -n "$out" ] || return
    first="${out%%$'\n'*}"

    if [ "${first#:delegate }" != "$first" ]; then
        # `ws cmd <name> -- <command>`: bash-completion (4.1+) knows how to
        # complete a command that starts partway along the line. macOS ships
        # bash 3.2 without it, so fall back to command names then filenames.
        local rest="${first#:delegate }"
        local start="${rest%% *}"
        if declare -F _command_offset >/dev/null 2>&1; then
            _command_offset "$start"
        elif [ "$COMP_CWORD" -eq "$start" ]; then
            COMPREPLY=( $(compgen -c -- "$cur") )
        else
            COMPREPLY=( $(compgen -f -- "$cur") )
        fi
        return
    fi

    # Descriptions are zsh's luxury; bash takes the first field.
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "$(printf '%s\n' "$out" | cut -f1)" -- "$cur") )
}
complete -F _ws ws
SHIM
}

emit() {
    case "$SHELL_NAME" in
        zsh) zsh_shim ;;
        bash) bash_shim ;;
    esac | sed "s|@WS@|$WS|g"
}

if [ -z "$INSTALL" ]; then
    emit
    exit 0
fi

if [ "$SHELL_NAME" = zsh ]; then
    # The file has to land somewhere zsh actually searches, and $fpath is not a
    # fixed list — a Homebrew site-functions directory is only on it if the
    # config put it there, while a framework adds its own. So ask an
    # interactive zsh what its $fpath really is rather than guessing at paths.
    FPATH_DIRS="$(zsh -i -c 'print -l $fpath' 2>/dev/null || true)"
    on_fpath() { printf '%s\n' "$FPATH_DIRS" | grep -qxF "$1"; }
    usable() {
        # An fpath entry need not exist yet (oh-my-zsh lists its custom
        # directory either way) — a writable parent is enough to create it.
        [ -d "$1" ] && [ -w "$1" ] && return 0
        [ ! -e "$1" ] && [ -d "$(dirname "$1")" ] && [ -w "$(dirname "$1")" ]
    }

    DIR=""
    # Somewhere the tools that own it won't overwrite: your own zfunc, the
    # framework's *custom* area, then the shared site-functions directories.
    for d in "${ZDOTDIR:-$HOME}/.zfunc" "${ZSH:-$HOME/.oh-my-zsh}/custom/completions" \
        /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions; do
        if on_fpath "$d" && usable "$d"; then
            DIR="$d"
            break
        fi
    done
    if [ -z "$DIR" ]; then
        # Any other directory zsh searches, minus a framework's own tree (an
        # update would wipe the file) and the root-owned system ones.
        while read -r d; do
            [ -n "$d" ] || continue
            case "$d" in
                */custom/completions) ;;
                *"/.oh-my-zsh/"*) continue ;;
            esac
            if usable "$d"; then
                DIR="$d"
                break
            fi
        done <<EOF
$FPATH_DIRS
EOF
    fi
    if [ -z "$DIR" ]; then
        # Nothing on $fpath is ours to write to: install anyway, and hand back
        # the one line that makes zsh look there.
        DIR="${ZDOTDIR:-$HOME}/.zfunc"
        echo "note: add this to .zshrc, above compinit — fpath=($DIR \$fpath)" >&2
    fi
    mkdir -p "$DIR"
    emit > "$DIR/_ws"
    echo "installed $DIR/_ws"
    # compinit rebuilds its dump when a completion directory changes, so a new
    # shell is all it takes — but a stale dump is the classic reason a fresh
    # completion "does nothing", so it is worth being explicit.
    echo "open a new shell to pick it up (if it still doesn't complete: rm -f ${ZDOTDIR:-$HOME}/.zcompdump*)"
else
    RC="$HOME/.bashrc"
    if grep -qsF 'ws completions bash' "$RC"; then
        echo "already installed in $RC"
    else
        printf '\n# ws completions\neval "$(%s completions bash)"\n' "$WS" >> "$RC"
        echo "added the eval line to $RC"
    fi
    echo "open a new shell to pick it up"
fi
